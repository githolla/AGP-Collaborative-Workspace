# ---------------------------------------------------------------------------
# Environment variables — canonical names. Copy to .env locally (never commit
# .env), and use these EXACT names in Vercel → Project → Settings →
# Environment Variables. The sync adapters read these names when live
# credentials replace fixtures.
#
# SECURITY RULES
# - Server-side secrets must NOT be prefixed VITE_. Vite bakes every VITE_*
#   variable into the public browser bundle. No VITE_ prefix = never shipped
#   to the client.
# - In Vercel, mark all *_TOKEN / *_KEY values as "Sensitive".
# - The two VITE_SUPABASE_* values below are the ONLY ones designed to be
#   public (the anon key is safe by design; Row Level Security does the
#   protecting).
# ---------------------------------------------------------------------------

# --- Kantata OX (server-side only; sync mirror + resourcing reservations) ---
KANTATA_API_TOKEN=
# Optional override; defaults to the standard OX endpoint.
KANTATA_API_BASE=https://api.mavenlink.com/api/v1

# --- HubSpot (server-side only; private-app token, pat-na1-…) ---------------
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Supabase ----------------------------------------------------------------
# Server-side (services, migrations, admin). NEVER expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe pair for the tab app (public by design, guarded by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Microsoft SSO via Supabase Auth (Azure provider) ---------------------
# Flip AUTH_REQUIRED=true to require a valid Supabase session token on /api.
AUTH_REQUIRED=
# Enable/disable the Microsoft button in the frontend.
VITE_ENABLE_MICROSOFT_LOGIN=true
# Optional explicit redirect URI for Supabase OAuth flow.
# Example local value: http://localhost:3000
VITE_SUPABASE_REDIRECT_URI=

# --- Anthropic (server-side only; activates the LLM collaboration agents) ---
ANTHROPIC_API_KEY=

# --- Tour feedback admin --------------------------------------------------
# Passcode for #admin/feedback (the tour-feedback roll-up + CSV export).
# Unset falls back to "agp-feedback" so local dev works. This is a shared
# passcode, NOT authentication — replace it with a sign-in check once Entra
# SSO is configured (BLOCKERS #5).
VITE_FEEDBACK_ADMIN_CODE=
