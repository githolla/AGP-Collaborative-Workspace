# ---------------------------------------------------------------------------
# Environment variables — canonical names. Copy to .env locally (never commit
# .env), and use these EXACT names in Vercel → Project → Settings →
# Environment Variables. The sync adapters read these names when live
# credentials replace fixtures.
#
# SECURITY RULES
# - Server-side secrets must NOT be prefixed VITE_. Vite bakes every VITE_*
#   variable into the public browser bundle. No VITE_ prefix = never shipped
#   to the client.
# - In Vercel, mark all *_TOKEN / *_KEY values as "Sensitive".
# - The two VITE_SUPABASE_* values below are the ONLY ones designed to be
#   public (the anon key is safe by design; Row Level Security does the
#   protecting).
# ---------------------------------------------------------------------------

# --- Kantata OX (server-side only; sync mirror + resourcing reservations) ---
KANTATA_API_TOKEN=
# Optional override; defaults to the standard OX endpoint.
KANTATA_API_BASE=https://api.mavenlink.com/api/v1
# WRITE-BACK KILL SWITCH. Unset (or anything but "true") makes /api/kantata-write
# a dry run: it validates the intents and reports the exact calls it would make,
# and sends nothing to Kantata. Set to "true" only when you intend edits made in
# the workspace to change AGP's system of record.
# Requires KANTATA_API_TOKEN to carry story + workspace_allocation write scope.
KANTATA_WRITE_ENABLED=

# --- HubSpot (server-side only; private-app token, pat-na1-…) ---------------
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Supabase ----------------------------------------------------------------
# Server-side (services, migrations, admin). NEVER expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (server-side only), for /api handlers that read
# or write the `collab` schema (teams-provisioning-plan.md B6). NOT the same
# credential as the two above — those are REST API keys, this is a database
# connection string. `collab` is not exposed through Supabase's auto-generated
# REST API (only public/graphql_public are), so these handlers connect to
# Postgres directly and enforce RLS themselves per request — see
# api/_lib/db.ts for exactly how.
#
# Use the TRANSACTION POOLER connection string (port 6543), not the direct
# connection (5432): Vercel functions are short-lived and highly concurrent,
# and the direct connection's limit is exhausted fast under that pattern.
# Dashboard → Project Settings → Database → Connection string → Transaction.
SUPABASE_DB_URL=

# Browser-safe pair for the tab app (public by design, guarded by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Microsoft SSO via Supabase Auth (Azure provider) ---------------------
# Flip AUTH_REQUIRED=true to require a valid Supabase session token on /api.
AUTH_REQUIRED=
# Enable/disable the Microsoft button in the frontend.
VITE_ENABLE_MICROSOFT_LOGIN=true
# Optional explicit redirect URI for Supabase OAuth flow.
# Example local value: http://localhost:3000
VITE_SUPABASE_REDIRECT_URI=

# --- Microsoft Graph, delegated (docs/teams-provisioning-plan.md B1) --------
# A SEPARATE token surface from the Supabase sign-in above — see
# apps/tab/src/auth/graphAuth.ts's own header for why. Same Entra app
# registration as the SSO one (BLOCKERS #5), but MSAL.js needs its OWN
# Single-page application redirect URI entry (A1①) alongside the existing
# Web platform entry Supabase's OAuth callback uses — and the delegated
# Graph scopes (A1②: Channel.Create, TeamMember.ReadWrite.All,
# User.ReadBasic.All, Files.ReadWrite.All, User.Invite.All) need org-wide
# admin consent, separate from the sign-in consent already granted.
# Public values, not secrets — SPA + PKCE, no client secret anywhere in this
# path (docs/teams-provisioning-plan.md's own architecture note).
VITE_GRAPH_CLIENT_ID=
VITE_GRAPH_TENANT_ID=
# Optional explicit redirect URI for the MSAL SPA platform entry — defaults
# to the app's own origin (window.location.origin) when unset, which is
# almost always correct.
VITE_GRAPH_REDIRECT_URI=

# --- Microsoft Graph, APPLICATION credential (two-way Teams sync only) -------
# When someone types in a Teams channel, no user is signed in to forward a
# token, so reading that message and running the change-notification
# subscription need an APPLICATION identity (client-credentials flow) with the
# app permissions ChannelMessage.Read.All + Channel.ReadBasic.All (admin
# consented). This is the SAME Entra app registration as the SSO/delegated
# flow, so the client id and tenant id are already set as VITE_GRAPH_CLIENT_ID /
# VITE_GRAPH_TENANT_ID above and reused automatically (api/_lib/graphApp.ts) —
# no duplicates needed. Only the SECRET is genuinely new, and it is app-only:
# it must NEVER be given a VITE_ prefix (that would ship it to the browser).
# Leave unset to keep two-way Teams sync fully off — the app no-ops cleanly.
GRAPH_APP_CLIENT_SECRET=
# Optional overrides ONLY if the app-credential flow uses a different Entra app
# than the sign-in one; otherwise leave unset and the VITE_GRAPH_* values apply.
GRAPH_APP_CLIENT_ID=
GRAPH_APP_TENANT_ID=

# Public https URL Microsoft Graph calls back with Teams notifications, i.e.
# <your-deployed-origin>/api/teams-webhook. Graph validates it synchronously at
# subscribe time and posts channel-message notifications to it thereafter.
# Required for two-way Teams sync; unset = sync stays off.
TEAMS_WEBHOOK_URL=

# --- App admin bootstrap (teams-provisioning-plan.md D1/D2) -----------------
# Comma-separated emails. INTERIM: read client-side because there is no
# server-side role check yet (see workspace/roles.ts's own docstring) — this
# gates the #admin route and "Clear workspace" from a normal signed-in user,
# but is not itself the security boundary. When B6 lands, real enforcement
# moves server-side as a non-VITE_ `APP_ADMIN_EMAILS`, checked per request.
VITE_APP_ADMIN_EMAILS=

# --- Anthropic (server-side only; activates the LLM collaboration agents) ---
ANTHROPIC_API_KEY=

# --- Tour feedback admin --------------------------------------------------
# Passcode for #admin/feedback (the tour-feedback roll-up + CSV export).
# Unset falls back to "agp-feedback" so local dev works. This is a shared
# passcode, NOT authentication — replace it with a sign-in check once Entra
# SSO is configured (BLOCKERS #5).
VITE_FEEDBACK_ADMIN_CODE=
